{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^(mcp__.*__)?m3e_(context|get|create|update|delete|feedback)$",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" PreToolUse", "timeout": 5, "additionalContextLimit": 24000 }]
    }],
    "PostToolUse": [{
      "matcher": "^(mcp__.*__)?m3e_(context|get|create|update|delete|feedback)$",
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" PostToolUse", "timeout": 5, "additionalContextLimit": 1500 }]
    }],
    "SessionEnd": [{
      "hooks": [{ "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.mjs\" SessionEnd", "timeout": 3 }]
    }]
  }
}
