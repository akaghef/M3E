<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.m3e.remote-backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>@NODE@</string>
        <string>@CHECKOUT@/beta/dist/node/sync/remote_backup_cli.js</string>
        <string>@REMOTE_URL@</string>
        <string>@BACKUP_DIR@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>StandardOutPath</key>
    <string>@LOG_DIR@/remote-backup.log</string>
    <key>StandardErrorPath</key>
    <string>@LOG_DIR@/remote-backup.err.log</string>
</dict>
</plist>
