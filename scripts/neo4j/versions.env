# The one place that pins the Neo4j and Java versions for M3E: the per-device installers
# (scripts/neo4j/install.sh, install.ps1) read it, and installer-lint fails when a CI Neo4j
# service image (neo4j:<NEO4J_VERSION>-community) differs from it.
NEO4J_VERSION=2026.10.2
TEMURIN_RELEASE=jdk-21.0.13.1+2
